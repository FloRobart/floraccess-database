# Comments stay on their own line: after an empty value, Compose would read them as the value

# Database
DB_NAME=floraccess
DB_USER=floraccess
DB_VOLUME_NAME=floraccess_db_data

# Production only (the password lives in the secrets/ folder, see README.md)
DB_MEMORY_LIMIT=1g

# Development only. Commented out so they never reach a production .env:
# docker-compose.dev.yml has a default value for each of them.
# DB_PASSWORD=postgres
# DB_PORT=5432
# HOST_UID=1000
# HOST_GID=1000
